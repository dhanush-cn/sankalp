# Copy to .env. Environment variables always win over this file.
# All settings are prefixed SANKALP_ (see src/sankalp/config.py).

SANKALP_ENVIRONMENT=dev
SANKALP_LOG_LEVEL=INFO

# One Postgres on 5432, two databases. sankalp_test must end in _test -- the
# truncate fixture checks that before it wipes anything.
SANKALP_DATABASE_URL=postgresql://sankalp:sankalp@localhost:5432/sankalp
SANKALP_TEST_DATABASE_URL=postgresql://sankalp:sankalp@localhost:5432/sankalp_test

# sankalp_app (migrations/004_restricted_role.sql): neither a superuser nor a table
# owner. The API and workers connect as this, not as sankalp -- migrations and the
# test truncate fixture keep using the two DSNs above, since DDL and TRUNCATE are
# exactly what this role must not have.
SANKALP_APP_DATABASE_URL=postgresql://sankalp_app:sankalp_app@localhost:5432/sankalp
SANKALP_TEST_APP_DATABASE_URL=postgresql://sankalp_app:sankalp_app@localhost:5432/sankalp_test

# Size to Postgres cores x 2-4, not to HTTP concurrency.
SANKALP_DB_POOL_MIN_SIZE=4
SANKALP_DB_POOL_MAX_SIZE=16

SANKALP_REDIS_URL=redis://localhost:6379/0
SANKALP_OUTBOX_REDIS_TIMEOUT_SECONDS=5.0

# Token bucket per route class (submit/read/cancel), fronted by a circuit breaker that fails
# open -- a dead rate limiter must not become a dead API. See resilience/ratelimit.py and
# resilience/circuit.py. State lives only in Redis; losing it on restart is harmless.
SANKALP_RATELIMIT_ENABLED=true
SANKALP_RATELIMIT_CAPACITY=100
SANKALP_RATELIMIT_REFILL_PER_SECOND=50.0
SANKALP_RATELIMIT_SUBMIT_COST=5
SANKALP_RATELIMIT_READ_COST=1
SANKALP_RATELIMIT_CANCEL_COST=1
SANKALP_RATELIMIT_KEY_PREFIX=sankalp.ratelimit
# Sub-millisecond in practice; 50ms is ~50x headroom. Deliberately far below
# OUTBOX_REDIS_TIMEOUT_SECONDS above -- that 5s budget is fine for a background batch and much
# too slow to sit inline on a request.
SANKALP_RATELIMIT_REDIS_TIMEOUT_SECONDS=0.05
SANKALP_RATELIMIT_BREAKER_FAILURE_THRESHOLD=5
SANKALP_RATELIMIT_BREAKER_COOLDOWN_SECONDS=5.0

# The drain: claims outbox rows, XADDs them to a Redis Stream, marks them published.
# At-least-once -- consumers must dedupe on the event_id field. See docs/spec.md, "The Outbox".
SANKALP_OUTBOX_BATCH_SIZE=100
SANKALP_OUTBOX_POLL_INTERVAL_SECONDS=0.2
SANKALP_OUTBOX_STREAM=sankalp.events
SANKALP_OUTBOX_STREAM_MAXLEN=100000
# True: sankalp-worker also runs the drain as a sibling task. False: run sankalp-drain
# (`make drain`) as its own process instead.
SANKALP_OUTBOX_DRAIN_IN_WORKER=true

# Lease duration bounds how long crash recovery takes: a dead worker's rows
# become claimable only once its lease expires.
SANKALP_LEASE_DURATION_SECONDS=30
SANKALP_WORKER_CONCURRENCY=32
SANKALP_DEQUEUE_BATCH_SIZE=10
SANKALP_MAX_ATTEMPTS=5

SANKALP_API_HOST=0.0.0.0
SANKALP_API_PORT=8000

# Tracing is a no-op while this is unset.
# SANKALP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
